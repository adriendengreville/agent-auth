#!/bin/sh
# POSIX entry point: also works when invoked using bash, zsh, or BusyBox sh.
set -eu
CDPATH='' cd -- "$(dirname -- "$0")"
case "${1:-}" in --help|-h) cat <<'HELP'
Usage: ./configure [--port 2222] [--no-start] [--uninstall]
Run as root on the target Linux machine. Installs dependencies, creates the
agent account, enrolls TOTP interactively, and installs a dedicated SSH service.
--no-start configures without launching the listener (for image builders).
--uninstall restores original SSH/PAM files; retains account and OTP seed.
HELP
exit 0;; esac
[ "$(id -u)" = 0 ] || { echo 'Run as root: sudo ./configure' >&2; exit 1; }
[ "$(uname -s)" = Linux ] || { echo 'Install on the Linux target, not your macOS/Windows laptop.' >&2; exit 1; }
if [ "${1:-}" != --uninstall ]; then
  if command -v apt-get >/dev/null 2>&1; then
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install -y openssh-server libpam-google-authenticator libpam-modules qrencode python3 passwd
  elif command -v apk >/dev/null 2>&1; then
    apk add --no-cache openssh-server-pam google-authenticator libqrencode-tools python3 shadow linux-pam
  elif command -v dnf >/dev/null 2>&1; then
    dnf install -y openssh-server google-authenticator qrencode python3 shadow-utils pam
  elif command -v zypper >/dev/null 2>&1; then
    zypper --non-interactive install openssh google-authenticator-libpam qrencode python3 shadow pam
  elif command -v pacman >/dev/null 2>&1; then
    pacman -Syu --noconfirm --needed openssh libpam-google-authenticator qrencode python shadow pam
  else
    echo 'No recognized package manager. Trying the dependencies already installed.'
    echo 'Required: PAM-enabled OpenSSH, pam_google_authenticator, pam_succeed_if, Python 3, useradd, chpasswd.'
  fi
fi
command -v python3 >/dev/null 2>&1 || { echo 'Python 3 is required; install it using your appliance package manager.' >&2; exit 1; }
exec python3 lib/setup.py "$@"
